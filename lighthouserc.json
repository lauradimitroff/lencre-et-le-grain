{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4181 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4181/",
        "http://localhost:4181/librairie",
        "http://localhost:4181/carte",
        "http://localhost:4181/histoire"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
